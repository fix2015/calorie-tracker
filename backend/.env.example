DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calorie_tracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
UPLOAD_DIR=./uploads
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# S3 (optional — falls back to local storage if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=eu-central-1
# Sign in with Apple / Google (optional — /api/auth/providers reports false and the buttons hide when unset)
# In production these go into the base64 BACKEND_ENV GitHub Actions secret (see .github/workflows/deploy.yml)
# GOOGLE_CLIENT_IDS: comma-separated OAuth client ids (web,ios,android)
GOOGLE_CLIENT_IDS=
# APPLE_AUDIENCES: bundle id FIRST, then the Services ID
APPLE_AUDIENCES=app.probooking.calorize,app.probooking.calorize.web
APPLE_TEAM_ID=46L2523L2V
# Key ID of the Sign in with Apple .p8 key, and the .p8 contents on one line with newlines as \n
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://calories.probooking.app/api/auth/apple/callback
# Deep link the Apple callback returns to on Android
APPLE_ANDROID_APP_SCHEME=app.probooking.calorize
# Encrypts stored Apple refresh tokens (defaults to a key derived from JWT_SECRET)
SOCIAL_TOKEN_ENCRYPTION_KEY=
