# Copy to .env (web dev) — the native build reads .env.capacitor instead.
VITE_API_URL=http://localhost:3001/api
VITE_BASE_PATH=/
VITE_API_BASE=
# Sign in with Apple / Google — public OAuth client ids. Leave empty to hide that button.
# VITE_GOOGLE_IOS_CLIENT_ID also becomes the iOS URL scheme (scripts/native-social-config.mjs).
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_APPLE_SERVICE_ID=
