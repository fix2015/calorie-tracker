FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_API_BASE=$VITE_API_BASE
# Social login client ids (public values; empty = that button stays hidden)
ARG VITE_GOOGLE_WEB_CLIENT_ID=
ARG VITE_GOOGLE_IOS_CLIENT_ID=
ARG VITE_APPLE_SERVICE_ID=
ENV VITE_GOOGLE_WEB_CLIENT_ID=$VITE_GOOGLE_WEB_CLIENT_ID
ENV VITE_GOOGLE_IOS_CLIENT_ID=$VITE_GOOGLE_IOS_CLIENT_ID
ENV VITE_APPLE_SERVICE_ID=$VITE_APPLE_SERVICE_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
